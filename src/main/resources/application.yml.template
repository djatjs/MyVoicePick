server:
  port: 8080

app:
  frontend-url: ${FRONTEND_URL:http://localhost:3000}

spring:
  # 파일 업로드 (음성 파일 용량 확장)
  servlet:
    multipart:
      max-file-size: 50MB
      max-request-size: 50MB

  # MySQL 로컬 개발 환경 통신 세팅
  datasource:
    url: jdbc:mysql://localhost:3306/voicepick_db?serverTimezone=Asia/Seoul&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: root
    driver-class-name: com.mysql.cj.jdbc.Driver

  # Redis 로컬 개발 환경 통신 세팅 (Task Queue)
  data:
    redis:
      host: localhost
      port: 6379

  # OAuth2 보안 세팅
  security:
    oauth2:
      client:
        registration:
          google:
            client-id: 948770031603-406dl145k7deta9af5e95vnlg20a9nlj.apps.googleusercontent.com
            client-secret: ${GOOGLE_CLIENT_SECRET}
            scope: profile, email
          naver:
            client-id: uuR2gwwy9rSDXagZzLv7
            client-secret: ${NAVER_CLIENT_SECRET}
            redirect-uri: "{baseUrl}/{action}/oauth2/code/{registrationId}"
            authorization-grant-type: authorization_code
            scope: name, email
            client-name: Naver
          kakao:
            client-id: f0e22e7f692c3208353bda0c0e21ebeb
            client-secret: ${KAKAO_CLIENT_SECRET}
            client-authentication-method: client_secret_post
            redirect-uri: "{baseUrl}/{action}/oauth2/code/{registrationId}"
            authorization-grant-type: authorization_code
            scope: profile_nickname, account_email
            client-name: Kakao
        provider:
          naver:
            authorization-uri: https://nid.naver.com/oauth2.0/authorize
            token-uri: https://nid.naver.com/oauth2.0/token
            user-info-uri: https://openapi.naver.com/v1/nid/me
            user-name-attribute: response
          kakao:
            authorization-uri: https://kauth.kakao.com/oauth/authorize
            token-uri: https://kauth.kakao.com/oauth/token
            user-info-uri: https://kapi.kakao.com/v2/user/me
            user-name-attribute: id

  # JWT 설정
  jwt:
    # 안전을 위해 충분히 길고 복잡한 Secret Key (최소 256bit 권장)
    secret: ${JWT_SECRET}
    # 만료 시간 (밀리초): 86400000ms = 1일
    expiration-time: 86400000

  # AWS S3 연동 설정
  cloud:
    aws:
      credentials:
        access-key: ${AWS_ACCESS_KEY_ID}      # 이름 변경!
        secret-key: ${AWS_SECRET_ACCESS_KEY}  # 이름 변경!
      region:
        static: ${AWS_DEFAULT_REGION:ap-northeast-2} # 이름 변경!
      s3:
        bucket: ${AWS_S3_BUCKET}


  # JPA 및 Hibernate 옵션
  jpa:
    hibernate:
      ddl-auto: update      # 애플리케이션 실행 시 Entity를 분석하여 DB 테이블 스키마 자동 수정
    show-sql: true          # 실행되는 하이버네이트 로직을 쿼리로 콘솔 출력
    properties:
      hibernate:
        format_sql: true    # 출력되는 쿼리를 보기 좋게 정렬(Formatting)

logging:
  level:
    # 우리가 작성한 핵심 비즈니스 로직의 로그를 DEBUG 모드로 띄워 세밀한 관제 가능
    com.MyVoicePick.demo: DEBUG
    # 참고: 쿼리 실행 시 바인딩되는 Parameter를 보려면 org.hibernate.SQL 등을 TRACE로 볼 수 있지만 여기선 생략

  # 토스페이먼츠 (Toss Payments) 환경변수 설정
toss:
  payment:
    secret-key: ${TOSS_SECRET_KEY}
